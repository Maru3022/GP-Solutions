        <sql>ALTER TABLE contacts ALTER COLUMN id RESTART WITH 100</sql>
        <sql>ALTER TABLE address ALTER COLUMN id RESTART WITH 100</sql>
        <sql>ALTER TABLE hotel ALTER COLUMN id RESTART WITH 100</sql>
